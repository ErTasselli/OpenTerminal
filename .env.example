# Local environment for OpenTerminal. Copy .env.example to .env and fill in
# only the optional integrations you use. This file is gitignored.

# ---- API server ----
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# API_KEY=
# DATA_DIR=

# ---- Web app ----
API_URL=http://localhost:4000
# API_KEY_FILE=../data/.api-key

# ---- Optional AI assistant (also editable from /settings) ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Optional Schwab real-time data (also editable from /settings) ----
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1
# SCHWAB_REFRESH_TOKEN=
# SCHWAB_ACCESS_TOKEN=
# SCHWAB_TOKEN_FILE=
